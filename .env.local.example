# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (ห้ามอัปโหลดไฟล์ .env.local ขึ้น GitHub)

# จากไฟล์ JSON ของ Service Account ที่โหลดมา
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@xxx.iam.gserviceaccount.com
# คัดลอกค่า private_key ทั้งหมดจากไฟล์ JSON มาใส่ตรงนี้ (มี \n อยู่ในนั้น ให้คงไว้ตามเดิม แล้วครอบด้วยเครื่องหมายคำพูด)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxxx\n-----END PRIVATE KEY-----\n"

# เอามาจาก URL ของ Google Sheet: .../d/[ตรงนี้]/edit
GOOGLE_SHEET_ID=1zQ9vsjDsCtC_ZhaYi_bTBgEoqFXqnjYogco61XpqiaE

# รหัสผ่านสำหรับทีมงานล็อกอินเข้าเว็บ ตั้งเองได้เลย
TEAM_PASSWORD=changeme123
